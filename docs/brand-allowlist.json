    "'[A-Z0-9_]*FERDIUM[A-Z0-9_]*'",
    "Ferdium:",
    "ferdium-components\\.types",
    "ferdiumVersion",
    "getFerdiumVersion",
    "lockFerdiumShortcutKey",
